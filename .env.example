# ClassSnap Environment Configuration Example

# Application
APP_NAME=ClassSnap
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# Security & Privacy
SECRET_KEY=dev-secret-key-change-in-production-classsnap-2026
CORS_ALLOWED_ORIGINS=http://localhost:8000
PHOTO_RETENTION_DAYS=0
AUTO_DELETE_TEMP_PHOTOS=true

# Database Persistence
DATABASE_URL=sqlite:///./classsnap.db

# Computer Vision Models
MODELS_DIR=./models
YUNET_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=./models/face_recognition_sface_2021dec.onnx

# Storage Paths
UPLOAD_DIR=./uploads
EXPORTS_DIR=./exports
